# ---- Core ----
# Postgres connection string (used by backend, alembic)
DATABASE_URL=postgresql+asyncpg://forge:forge@db:5432/forge
# Redis connection string (Celery broker + result backend, live-run state)
REDIS_URL=redis://redis:6379/0
# Postgres password used by docker-compose.prod.yml (overrides DATABASE_URL
# interpolation in the prod compose)
POSTGRES_PASSWORD=forge

# ---- Auth / JWT ----
# Secret used to sign JWT access/refresh tokens — CHANGE IN PRODUCTION (32+ bytes)
JWT_SECRET_KEY=qa-only-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public frontend origin (used to build invite / verification links)
FRONTEND_URL=http://localhost:5173

# ---- LLM (AI Cortex) ----
# OpenAI-compatible endpoint (DeepSeek, vLLM, Ollama, ...)
LLM_BASE_URL=https://api.deepseek.com/v1
# Leave empty to use the deterministic mock provider (dev mode)
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# auto (mock when no key, openai-compatible otherwise) or mock (force mock)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Per-1k-token pricing; 0.0 disables cost tracking (cost_usd -> 0.0)
LLM_COST_PER_1K_INPUT_TOKENS=0.0
LLM_COST_PER_1K_OUTPUT_TOKENS=0.0

# ---- Stripe billing ----
STRIPE_SECRET_KEY=
# Dummy webhook secret enables the /webhooks/stripe endpoint in the QA stack
# so the signature-check contract (P2T015) is exercised; never a real secret.
STRIPE_WEBHOOK_SECRET=whsec_qa-test-signing-secret
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# ---- Email (SMTP) ----
# Empty SMTP_HOST = console backend (logs emails; dev/test default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM=The Forge <noreply@forge.app>
SMTP_FROM=noreply@forge.local

# ---- Reports ----
# Backend container runs as an unprivileged user against a root-owned repo
# volume, so use a writable path for exported PDFs (served via /reports).
REPORT_STORAGE_DIR=/tmp/reports

# ---- Observability (T48) ----
# Empty SENTRY_DSN disables Sentry. /metrics (Prometheus) is always exposed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Security (T49) ----
# QA is a disposable test environment: keep the dev security posture (no HSTS)
# and allow localhost origins. The global + auth rate limiters stay enabled so
# Phase 5 can exercise them, but the limits are generous enough that the
# black-box suite (which shares one remote address) is not throttled.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Global + auth route rate limits ("N/minute" strings)
RATE_LIMIT_DEFAULT=1000/minute
RATE_LIMIT_AUTH=300/minute
RATE_LIMIT_REGISTER=300/minute
# TESTING=true disables the global rate limiter (used by the test suite)
TESTING=false
