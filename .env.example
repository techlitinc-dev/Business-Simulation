# ---- Core ----
# Postgres connection string (used by backend, alembic)
DATABASE_URL=postgresql+asyncpg://forge:forge@db:5432/forge
# Redis connection string (Celery broker + result backend, live-run state)
REDIS_URL=redis://redis:6379/0
# Postgres password used by docker-compose.prod.yml (overrides DATABASE_URL
# interpolation in the prod compose)
POSTGRES_PASSWORD=forge

# ---- Auth / JWT ----
# Secret used to sign JWT access/refresh tokens — CHANGE IN PRODUCTION (32+ bytes)
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public frontend origin (used to build invite / verification links)
FRONTEND_URL=http://localhost:5173

# API base URL baked into the frontend build. Empty = same-origin (requests
# go to /api/* and the prod nginx proxies to the backend). In dev the Vite
# dev server proxies to the backend directly, so this can stay empty too.
# Set to an absolute URL only when the API lives on a different origin.
VITE_API_URL=

# ---- LLM (AI Cortex) ----
# OpenAI-compatible endpoint (DeepSeek, vLLM, Ollama, ...)
LLM_BASE_URL=https://api.deepseek.com/v1
# Leave empty to use the deterministic mock provider (dev mode)
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# auto (mock when no key, openai-compatible otherwise) or mock (force mock)
LLM_PROVIDER=auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
# Per-1k-token pricing; 0.0 disables cost tracking (cost_usd -> 0.0)
LLM_COST_PER_1K_INPUT_TOKENS=0.0
LLM_COST_PER_1K_OUTPUT_TOKENS=0.0

# ---- Stripe billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=

# ---- Email (SMTP) ----
# Empty SMTP_HOST = console backend (logs emails; dev/test default)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM=The Forge <noreply@forge.app>
SMTP_FROM=noreply@forge.local

# ---- Observability (T48) ----
# Empty SENTRY_DSN disables Sentry. /metrics (Prometheus) is always exposed.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Security (T49) ----
# "production" enables Strict-Transport-Security; set CORS_ORIGINS to the real
# frontend domain in production (comma-separated; never "*").
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Global + auth route rate limits ("N/minute" strings)
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REGISTER=20/minute
# TESTING=true disables the global rate limiter (used by the test suite)
TESTING=false
